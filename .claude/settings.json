{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-branch-create.sh\"",
            "timeout": 15,
            "statusMessage": "Checking main is up to date and no unmerged branches..."
          }
        ]
      }
    ]
  }
}
